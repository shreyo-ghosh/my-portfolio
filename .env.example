# Optional: Formspree form ID for server-side lead capture.
# Create a form at https://formspree.io and paste the ID (e.g. xyzabcde).
# If unset, the contact form opens WhatsApp with a prefilled message.
VITE_FORMSPREE_ID=

# Jarvis Lambda webhook (same URL as Telegram). Leads + /desk chat.
# Example: https://xmkwdl0d1d.execute-api.ap-south-1.amazonaws.com/webhook
VITE_JARVIS_WEBHOOK_URL=
VITE_JARVIS_AGENT_NAME=Jarvis

# Same value as DESK_TOKEN on the Jarvis Lambda / SSM. Never commit the real token.
VITE_DESK_TOKEN=
